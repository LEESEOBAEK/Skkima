{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema-workflow.local/contracts/relationship-registry.schema.json",
  "title": "Dashboard Relationship Registry",
  "type": "object",
  "required": ["schema_version", "revision", "project", "sessions", "relations", "updated_at"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "revision": { "type": "integer", "minimum": 0 },
    "project": {
      "type": "object",
      "required": ["project_id", "source_root"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "source_root": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session_id", "project_id", "name", "created_at"],
        "properties": {
          "session_id": { "type": "string", "minLength": 1 },
          "project_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "dashboard-relationship.schema.json" }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
