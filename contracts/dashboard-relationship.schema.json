{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema-workflow.local/contracts/dashboard-relationship.schema.json",
  "title": "Dashboard Minimal Relationship",
  "type": "object",
  "required": [
    "schema_version",
    "relation_id",
    "source_id",
    "relation_type",
    "target_id",
    "status",
    "evidence_refs",
    "created_at",
    "created_by"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "relation_id": { "type": "string", "pattern": "^rel_[A-Za-z0-9_-]+$" },
    "source_id": { "type": "string", "minLength": 1 },
    "relation_type": {
      "enum": ["HAS_SESSION", "HAS_RUN", "CONTINUES", "SUPPORTED_BY", "PRODUCED", "HAS_DECISION"]
    },
    "target_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["confirmed", "unresolved", "conflict", "superseded"] },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "enum": ["user", "relationship_gateway", "migration"] },
    "supersedes_relation_id": { "type": ["string", "null"] },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}