{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema-workflow.local/contracts/context-capsule.schema.json",
  "title": "CLI Context Capsule",
  "type": "object",
  "required": [
    "capsule_version",
    "project_id",
    "session_id",
    "run_ref",
    "relation_status",
    "operation_kind",
    "required_action",
    "source_refs"
  ],
  "properties": {
    "capsule_version": { "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "run_ref": { "type": "string", "minLength": 1 },
    "relation_status": { "enum": ["confirmed", "unresolved"] },
    "operation_kind": { "enum": ["new_run", "continuation", "branch", "review"] },
    "required_action": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "parent_run_id": { "type": ["string", "null"] },
    "evidence_refs": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "artifact_refs": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "risk_level": { "enum": ["low", "medium", "high", "unknown"] },
    "unresolved_relation_id": { "type": ["string", "null"] },
    "summary": { "type": "string", "maxLength": 500 }
  },
  "additionalProperties": false
}