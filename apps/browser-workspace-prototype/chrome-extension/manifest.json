{
  "manifest_version": 3,
  "name": "Skkima Chrome Bridge",
  "version": "0.2.4",
  "description": "Read the active Chrome page on request and send evidence to Skkima.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1:3217/*",
    "http://localhost:3217/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Open Skkima Bridge"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
